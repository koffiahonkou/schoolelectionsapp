# Ensure index.html is NEVER aggressively cached by browsers or CDNs
/index.html
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

# Hashed assets in /assets/ can be safely cached because filenames contain hashes
/assets/*
  Cache-Control: public, max-age=31536000, immutable
