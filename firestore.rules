rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidVote(data) {
      return data.id is string &&
             data.choices is map &&
             data.isPractice is bool &&
             // STRICT BALLOT SECRECY: Ballot document MUST NOT contain voter personal identity
             !('voterId' in data) &&
             !('studentId' in data) &&
             !('fullName' in data) &&
             !('email' in data) &&
             !('pin' in data);
    }

    // 1. Aggregated Election Stats Document
    // Read: Allowed for everyone (dramatically reduces client real-time reads to just 1 doc!)
    // Write: Allowed for transaction increments & admin initialization
    match /election_stats/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // 2. Anonymous Cast Ballots Collection
    // Read: Allowed (ballots are strictly secret & anonymous without PII)
    // Create: Allowed if anonymous and properly structured
    // Delete: Allowed for admin system wipe and reset
    match /votes/{voteId} {
      allow read: if true;
      allow create: if isValidVote(request.resource.data);
      allow update: if false;
      allow delete: if true;
    }

    // 3. Registered Voters Collection
    match /voters/{voterId} {
      allow read, write: if true;
    }

    // 4. Voter Tokens Collection
    match /voter_tokens/{tokenId} {
      allow read, write: if true;
    }

    // 5. Live Agent Monitoring Collection
    match /agent_monitoring/{agentId} {
      allow read: if true;
      allow write: if true;
    }

    // 6. Election Metadata and Status Sync
    match /election_metadata/{docId} {
      allow read: if true;
      allow write: if true;
    }
  }
}

